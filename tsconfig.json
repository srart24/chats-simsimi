{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "outDir": "./dist/esm",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "declaration": false,
    "sourceMap": false,
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
