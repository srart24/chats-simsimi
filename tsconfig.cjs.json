{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ESNext",
    "outDir": "./dist/cjs",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "declaration": false,
    "sourceMap": false,
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
