  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "simsimi",
    "chats-simsimi",
    "srart24"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srart24/chats-simsimi.git"
  },
  "bugs": {
    "url": "https://github.com/srart24/chats-simsimi/issues"
  },
  "homepage": "https://github.com/srart24/chats-simsimi/tree/srart24",
  "dependencies": {
    "axios": "^1.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "typescript": "^5.5.4"
  }
}
